; Pensionista de ejemplo. Los datos personales son ficticios; la serie de IPC
; y las bases maximas de cotizacion son datos publicos.
;
; Copie este fichero al directorio que indique config.ini y editelo, o
; generelo desde sus propios informes del INSS con tools/informe_a_dat.py.

[formato]
version = 1

[titular]
nombre = NOMBRE APELLIDO APELLIDO
dni = 00000000T
regimen = General
modalidad = Jubilacion ordinaria (Ley 27/2011 - 65 anos + vida laboral completa)
fecha_calculo = 04/10/2026
version_informe = ejemplo
nacimiento = 15/03/1971

[informe]
; Lo que imprimio la simulacion oficial. En el ejemplo van a cero: no hay
; informe que comparar, asi que la columna "Informe" del Resumen mostrara
; simplemente el escenario de partida.
